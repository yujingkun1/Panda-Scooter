
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fafaf8 0%, #f0efe8 100%);
  padding: 48rpx 32rpx 64rpx;
}
.hero {
  padding: 32rpx 16rpx 40rpx;
  text-align: center;
}
.logo {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}
.title {
  display: block;
  font-size: 44rpx;
  color: #0b0e0d;
  font-weight: 500;
  letter-spacing: 4rpx;
}
.subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #737373;
  line-height: 1.6;
}
.card {
  background-color: #ffffff;
  border: 1rpx solid #e5e5e2;
  padding: 32rpx;
}
.section + .section {
  margin-top: 28rpx;
}
.section-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #0b0e0d;
  font-weight: 500;
}
.section-text {
  display: block;
  font-size: 24rpx;
  color: #525252;
  line-height: 1.8;
}

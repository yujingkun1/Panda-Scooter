<view class="page"><view class="header"><text class="title">账号管理</text></view><view class="info-section"><view class="info-item"><text class="info-label">姓名</text><text class="info-value">{{a}}</text></view><view class="info-item"><text class="info-label">邮箱</text><text class="info-value">{{b}}</text></view></view><view class="action-section"><view class="action-item" bindtap="{{c}}"><text class="action-text">修改密码</text></view><view class="action-item" bindtap="{{d}}"><text class="action-text logout-text">退出登录</text></view></view><view class="delete-section"><text class="section-title">注销账号</text><text class="section-desc">注销前请先输入当前密码和邮箱验证码。</text><view class="field"><text class="field-label">当前密码</text><view class="password-field"><input class="input password-input" password="{{e}}" type="text" placeholder="请输入当前密码" value="{{f}}" bindinput="{{g}}"/><view class="password-toggle ui-pressable" hover-class="ui-pressable-hover" hover-stay-time="70" bindtap="{{i}}"><image class="password-toggle-icon" src="{{h}}" mode="aspectFit"></image></view></view></view><view class="field"><text class="field-label">验证码</text><view class="code-row"><input class="input code-input" type="text" placeholder="请输入验证码" value="{{j}}" bindinput="{{k}}"/><button class="code-btn" disabled="{{m}}" bindtap="{{n}}">{{l}}</button></view></view><button class="delete-btn" disabled="{{p}}" bindtap="{{q}}">{{o}}</button></view></view>
<view class="page"><view class="hero"><image class="logo" src="{{a}}" mode="aspectFit"></image><text class="title">{{b}}</text><text class="subtitle">{{c}}</text></view><view class="card"><view class="tabs"><view wx:for="{{d}}" wx:for-item="item" wx:key="b" class="{{['tab', 'ui-pressable', item.c && 'active']}}" hover-class="ui-pressable-hover" hover-stay-time="70" bindtap="{{item.d}}"><text class="tab-text">{{item.a}}</text></view></view><view wx:if="{{e}}" class="field"><text class="label">姓名</text><input class="input" type="text" placeholder="请输入真实姓名" value="{{f}}" bindinput="{{g}}"/></view><view class="field"><text class="label">邮箱</text><input class="input" type="text" placeholder="请输入邮箱" value="{{h}}" bindinput="{{i}}"/></view><view class="field"><text class="label">密码</text><view class="password-field"><input class="input password-input" password="{{j}}" type="text" placeholder="请输入密码" value="{{k}}" bindinput="{{l}}"/><view class="password-toggle ui-pressable" hover-class="ui-pressable-hover" hover-stay-time="70" bindtap="{{n}}"><image class="password-toggle-icon" src="{{m}}" mode="aspectFit"></image></view></view><text wx:if="{{o}}" class="{{['field-tip', q && 'ok']}}">{{p}}</text></view><view wx:if="{{r}}" class="field"><text class="label">验证码</text><view class="inline-field"><input class="input inline-input" type="text" placeholder="请输入验证码" value="{{s}}" bindinput="{{t}}"/><button class="code-btn" hover-class="button-hover" hover-start-time="0" hover-stay-time="90" disabled="{{w}}" bindtap="{{x}}">{{v}}</button></view></view><button class="submit-btn" hover-class="button-hover" hover-start-time="0" hover-stay-time="90" disabled="{{z}}" bindtap="{{A}}">{{y}}</button><view wx:if="{{B}}" class="agreement-row"><checkbox-group class="agreement-check" bindchange="{{D}}"><checkbox checked="{{C}}" value="privacy"></checkbox></checkbox-group><text class="agreement-text">我已阅读并同意</text><text class="agreement-link" bindtap="{{E}}">《隐私政策》</text></view><view class="footer-links"><view wx:if="{{F}}" class="link-button ui-pressable-inline" hover-class="ui-pressable-inline-hover" hover-stay-time="70" bindtap="{{G}}"><text class="link">注册账号</text></view><view wx:if="{{H}}" class="link-button ui-pressable-inline" hover-class="ui-pressable-inline-hover" hover-stay-time="70" bindtap="{{I}}"><text class="link">忘记密码</text></view><view wx:if="{{J}}" class="link-button ui-pressable-inline" hover-class="ui-pressable-inline-hover" hover-stay-time="70" bindtap="{{K}}"><text class="link">返回登录</text></view></view></view></view>